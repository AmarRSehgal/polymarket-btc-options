<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.amar.polymarket_btc_paper_session</string>
    <!-- Every 10 min (and on wake): session.py resumes today's 6h of awake paper time,
         or exits at once if it is already running or the budget is spent. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>-u</string>
        <string>PYTHONPATH</string>
        <string>/opt/local/bin/python3.13</string>
        <string>/Users/amar/personal/polymarket-btc-options/session.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/amar/personal/polymarket-btc-options</string>
    <key>StartInterval</key>
    <integer>600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/amar/personal/polymarket-btc-options/logs/launchd_session.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/amar/personal/polymarket-btc-options/logs/launchd_session.err</string>
</dict>
</plist>
